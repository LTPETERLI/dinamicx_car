<launch>
    <node pkg="nodelet" type="nodelet" name="pcl_manager" args="manager" output="screen"/>

    <node name="self_filter" pkg="sensor_filters" type="pointcloud2_filter_chain" output="screen">
        <rosparam command="load" file="$(find rm_navigation)/config/self_filter/filter_config.yaml"/>
        <remap from="~input" to="/livox/lidar_repost"/>
        <remap from="~output" to="/self_filtered"/>
    </node>

    <node pkg="nodelet" type="nodelet" name="voxel_grid" args="load pcl/VoxelGrid pcl_manager" output="screen">
        <remap from="~input" to="/ground_segmentation/obstacle_cloud"/>
        <rosparam>
            filter_field_name: z
            filter_limit_min: 0.03
            filter_limit_max: 2.0
            filter_limit_negative: False
            leaf_size: 0.01
        </rosparam>
    </node>

    <node pkg="nodelet" type="nodelet" name="cutoff" args="load pcl/StatisticalOutlierRemoval /pcl_manager"
          output="screen">
        <remap from="~input" to="/voxel_grid/output"/>
        <rosparam>
            mean_k: 6
            stddev: 0.05
        </rosparam>
    </node>

</launch>
