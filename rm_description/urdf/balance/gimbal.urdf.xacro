<?xml version="1.0" encoding="utf-8"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:property name="threshold" value="0.05"/>
    <xacro:property name="pitch_lower_limit" value="-0.737"/>
    <xacro:property name="pitch_upper_limit" value="0.470"/>

    <link name="yaw">
        <inertial>
            <mass value="1.978491"/>
            <origin xyz="-0.00087 0.016712 0.082999"/>
            <inertia ixx="1.189E-02" ixy="6.675E-05" ixz="1.346E-04" iyy="9.472E-03"
                     iyz="-2.222E-03" izz="4.904E-3"/>
        </inertial>
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <mesh filename="package://rm_description/meshes/balance/yaw.stl" scale="0.001 0.001 0.001"/>
            </geometry>
        </visual>
        <collision>
            <origin xyz="0 0 0.11" rpy="0 0 0"/>
            <geometry>
                <box size="0.12 0.16 0.115"/>
            </geometry>
        </collision>
    </link>

    <joint name="yaw_joint" type="revolute">
        <origin xyz="0 0 -0.06802"
                rpy="0 0 0"/>
        <dynamics damping="0.0" friction="0.1"/>
        <limit effort="1.2" velocity="31" lower="-1e10" upper="1e10"/>
        <parent link="base_link"/>
        <child link="yaw"/>
        <axis xyz="0 0 1"/>
    </joint>

    <link name="flank_frame"/>
    <joint name="flank_joint" type="fixed">
        <origin xyz="0 0 0" rpy="0 0 ${-pi/2}"/>
        <parent link="yaw"/>
        <child link="flank_frame"/>
    </joint>

    <link name="yaw_reverse_frame"/>
    <joint name="yaw_reverse_joint" type="fixed">
        <origin xyz="0 0 0" rpy="0 0 ${pi}"/>
        <parent link="yaw"/>
        <child link="yaw_reverse_frame"/>
    </joint>

    <link name="pitch">
        <inertial>
            <mass value="0.923947"/>
            <origin xyz="0.015661 0.004654 0"/>
            <inertia ixx="3.850E-03" ixy="1.1986E-05" ixz="5.159E-04" iyy="6.146E-03"
                     iyz="-1.379E-03" izz="5.506E-03"/>
        </inertial>
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <mesh filename="package://rm_description/meshes/balance/pitch.stl" scale="0.001 0.001 0.001"/>
            </geometry>
        </visual>
        <collision>
            <origin xyz="-0.04 0 0.08" rpy="0 0 0"/>
            <geometry>
                <box size="0.25 0.16 0.094"/>
            </geometry>
        </collision>
    </link>

    <joint name="pitch_joint" type="revolute">
        <origin xyz="0 0 0.219" rpy="0 0 0"/>
        <dynamics damping="0.0" friction="0.1"/>
        <limit effort="1.2" velocity="31" lower="${pitch_lower_limit}" upper="${pitch_upper_limit}"/>
        <safety_controller k_velocity="0.05"
                           k_position="100"
                           soft_lower_limit="${pitch_lower_limit+threshold}"
                           soft_upper_limit="${pitch_upper_limit-threshold}"/>
        <parent link="yaw"/>
        <child link="pitch"/>
        <axis xyz="0 1 0 "/>
    </joint>


</robot>
