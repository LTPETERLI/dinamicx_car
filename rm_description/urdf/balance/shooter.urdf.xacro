<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:include filename="$(find rm_description)/urdf/common/friction.urdf.xacro"/>
    <!--    <xacro:include filename="$(find rm_description)/urdf/standard/gimbal.urdf.xacro"/>-->
    <xacro:property name="wheel_offset_x" value="0.028"/>
    <xacro:property name="wheel_offset_y" value="0.041"/>
    <xacro:property name="wheel_offset_z" value="0.00346"/>

    <xacro:friction_wheel prefixs="left" connected_to="pitch"
                          wheel_x_offset="${wheel_offset_x}" wheel_y_offset="${wheel_offset_y}"
                          wheel_z_offset="${wheel_offset_z}"/>

    <xacro:friction_wheel prefixs="right" connected_to="pitch"
                          wheel_x_offset="${wheel_offset_x}" wheel_y_offset="${-wheel_offset_y}"
                          wheel_z_offset="${wheel_offset_z}"/>

    <link name="trigger">
        <inertial>
            <mass value="0.269095"/>
            <origin xyz="0 0 0.0013"/>
            <inertia ixx="1.497e-4" ixy="9.68649e-7" ixz="2.2776266e-5" iyy="2.583e-4"
                     iyz="1.4077e-7" izz="2.562e-4"/>
        </inertial>
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <mesh filename="package://rm_description/meshes/balance/trigger.stl" scale="0.001 0.001 0.001"/>
            </geometry>
        </visual>
        <collision>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <mesh filename="package://rm_description/meshes/balance/trigger.stl" scale="0.001 0.001 0.001"/>
            </geometry>
        </collision>
    </link>

    <joint name="trigger_joint" type="continuous">
        <origin xyz="-0.05817 0 0.0013" rpy="0 0 0"/>
        <dynamics damping="0.0" friction="0.01"/>
        <limit effort="1.0" velocity="43.54" lower="-1e16" upper="1e16"/>
        <parent link="pitch"/>
        <child link="trigger"/>
        <axis xyz="0 0 1 "/>
    </joint>

    <link name="cover">
        <inertial>
            <mass value="0.027279"/>
            <origin xyz="-0.008922 -0.042 -0.001"/>
            <inertia ixx="5.2865e-5" ixy="-8.393e-6" ixz="2.665e-10" iyy="8.4587e-5" iyz="0"
                     izz="1.374e-4"/>
        </inertial>
    </link>

    <joint name="cover_joint" type="revolute">
        <axis xyz="0 1 0"/>
        <origin xyz="-0.0089 0.04497 0.1147"/>
        <limit effort="1.0" velocity="43.54" lower="-0.3" upper="1.62"/>
        <dynamics damping="0.0" friction="0.1"/>
        <parent link="pitch"/>
        <child link="cover"/>
    </joint>

</robot>
