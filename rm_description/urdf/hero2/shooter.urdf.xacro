<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:include filename="$(find rm_description)/urdf/common/friction.urdf.xacro"/>


    <xacro:property name="wheel_offset_x" value="0.072"/>
    <xacro:property name="wheel_offset_y" value="0.049054"/>
    <xacro:property name="wheel_offset_z" value="0"/>


    <xacro:friction_wheel prefixs="left" connected_to="pitch"
                          wheel_x_offset="${wheel_offset_x}" wheel_y_offset="${wheel_offset_y}"
                          wheel_z_offset="${wheel_offset_z}"/>

    <xacro:friction_wheel prefixs="right" connected_to="pitch"
                          wheel_x_offset="${wheel_offset_x}" wheel_y_offset="${-wheel_offset_y}"
                          wheel_z_offset="${wheel_offset_z}"/>


    <link name="trigger">
        <visual>
            <orgin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <mesh filename="package://rm_description/meshes/hero2/trigger.stl" scale="0.001 0.001 0.001"/>
            </geometry>
        </visual>
        <collision>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <mesh filename="package://rm_description/meshes/hero2/trigger.stl" scale="0.001 0.001 0.001"/>
            </geometry>
        </collision>
        <inertial>
            <mass value="0.262492"/>
            <origin xyz="0.025862 -0.001985 -0.0055"/>
            <inertia ixx="3.239E-4" ixy="-3.1219985E-5" ixz="-3.2964117E-5" iyy="9.072E-4"
                     iyz="-5.99223E-7" izz="1.027E-3"/>
        </inertial>
    </link>

    <joint name="trigger_joint" type="continuous">
        <origin xyz="-0.128 0 0.006" rpy="0 0 0"/>
        <dynamics damping="0.0" friction="0.01"/>
        <limit effort="5.26" velocity="47.5" lower="-1E16" upper="1E16"/>
        <parent link="base_link"/>
        <child link="trigger"/>
        <axis xyz="0 0 1 "/>
    </joint>

</robot>