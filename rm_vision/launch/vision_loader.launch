<node pkg="nodelet" type="nodelet" name="processor"
    args="load rm_digtialimg_proc/Processor $(arg manager_name)" >
   <rosparam file="$(find rm_digtialimg_proc)/config/weibull_coefficient.yaml" command="load" />
   <rosparam file="$(find rm_digtialimg_proc)/config/make_dataset.yaml" command="load" />
   <rosparam file="$(find rm_digtialimg_proc)/config/armor_coefficient.yaml" command="load" />
   <rosparam file="$(find rm_digtialimg_proc)/config/preprocess_coefficient.yaml" command="load" />
   <remap from="/processor/result_msg" to="/processor/result_msg"/>
   <remap from="debug_image" to="debug_image"/>
   <remap from="/galaxy_camera/image_raw" to="/galaxy_camera/galaxy_camera/image_raw"/>
</node>

<node pkg="rm_pose_solver" type="pose_solver_node" name="pose_solver_node" output="screen" >
  <rosparam file="$(find rm_pose_solver)/config/pose_solver_config.yaml" command="load" />
<!--    rewrite to="/upper(lower)_processor/result_msg" the same as Processor--> -->
  <remap from="/processor/result_msg" to="/processor/result_msg"/>
<!--    rewrite 'to=???/image_info' ??? is camera name -->
  <remap from="/galaxy_camera/camera_info" to="/galaxy_camera/galaxy_camera/camera_info"/>
<!--    rewrite 'to=upper(lower)_detection'--> -->
  <remap from="/detection" to="/detection"/>
</node>

<!-- <node pkg="nodelet" type="nodelet" name="windspeed" -->
<!--     args="load rm_windmill_speed/WindSpeed $(arg manager_name)" > -->
<!--     <rosparam file="$(find rm_windmill_speed)/config/windmill.yaml" command="load" /> -->
<!--     <rosparam file="$(find rm_windmill_speed)/config/camera.yaml" command="load" /> -->
<!--    <remap from="/hk_camera/image_raw" to="/galaxy_camera/image_raw"/> -->
<!-- </node> -->

<node pkg="nodelet" type="nodelet" name="forecast"
    args="load rm_forecast/Forecast_Node $(arg manager_name)" >
    <rosparam file="$(find rm_forecast)/config/forecast.yaml" command="load" />
    <rosparam file="$(find rm_forecast)/config/camera.yaml" command="load" />
       <remap from="/hk_camera/image_raw" to="/hk_camera/image_raw"/>
</node>

<node pkg="tf" type="static_transform_publisher" name="link1_broadcaster"
    args="0 0 0 -1.57 0 -1.57 odom camera_optical_frame 100" />

</launch>
