<launch>
    <arg name="rviz" default="false"/>

    <rosparam command="load" file="$(find rm_navigation)/config/lio_config/fast_mid360.yaml"/>


    <param name="feature_extract_enable" type="bool" value="false"/>
    <param name="point_filter_num" type="int" value="5"/>
    <param name="max_iteration" type="int" value="10"/>
    <param name="filter_size_surf" type="double" value="0.20"/>
    <param name="filter_size_map" type="double" value="0.20"/>
    <param name="cube_side_length" type="double" value="1000"/>
    <param name="runtime_pos_log_enable" type="bool" value="true"/>

    <param name="loopClosureEnableFlag" type="bool" value="true"/>


    <param name="surroundingkeyframeAddingDistThreshold" type="double" value="0.5"/>
    <param name="surroundingkeyframeAddingAngleThreshold" type="double" value="0.18"/>
    <param name="surroundingKeyframeDensity" type="double" value="0.5"/>


        <param name="pcd_save/pcd_save_en" type="bool" value="true"/>
        <param name="pcd_save/interval" type="int" value="50000"/>

    <arg name="map" default="/home/dynamicx/rm_ws/src/FAST_LIO/PCD/new_scans.pcd" />
    <remap from="Odometry" to="/odometry"/>

    <node pkg="tf" type="static_transform_publisher" name="map_odom_broadcaster2" args="0 0 0 0 0 0 map camera_init 100"/>
    <node pkg="tf" type="static_transform_publisher" name="map_odom_broadcaster1" args="0 0 0 0 0 0 map odom 100"/>
    <node pkg="fast_lio_sam" type="fastlio_sam_mapping" name="laserMapping" output="screen"/>


</launch>
