<launch>
    <arg name="rviz" default="false"/>

    <rosparam command="load" file="$(find robot_test_npg)/config/fast_mid360.yaml"/>
    <param name="feature_extract_enable" type="bool" value="false"/>
    <param name="point_filter_num" type="int" value="5"/>
    <param name="max_iteration" type="int" value="5"/>
    <param name="filter_size_surf" type="double" value="0.15"/>
    <param name="filter_size_map" type="double" value="0.20"/>
    <param name="cube_side_length" type="double" value="1000"/>
    <param name="runtime_pos_log_enable" type="bool" value="true"/>
<!--    <param name="pcd_save/pcd_save_en" type="bool" value="true"/>-->
<!--    <param name="pcd_save/interval" type="int" value="50000"/>-->
    <arg name="map" default="/home/dynamicx/rm_ws/src/FAST_LIO/PCD/new_scans.pcd" />
    <remap from="Odometry" to="/odometry"/>
    <node pkg="fast_lio" type="fastlio_mapping" name="laserMapping" output="screen"/>

<!--    <group if="$(arg rviz)">-->
